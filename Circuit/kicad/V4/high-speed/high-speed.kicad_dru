# =========================================================================
# Custom Design Rules for Jedlikbots v1.4.9 (Version 4 - The Final Stand)
# Generated by Bence's AI Assistant
# Készítette: Nagy Bence & a bosszúszomjas AI
# =========================================================================

(version 1)

# --- Onboard (External Layer) Rules in MM ---
# Ezek a szabályok működnek, ne nyúlj hozzájuk!

(rule Onboard_90R
    (constraint track_width (min 0.282mm) (max 0.282mm))
    (constraint diff_pair_gap (min 0.178mm) (max 0.178mm))
    (condition "(A.NetClass == '/USB2-HUB/*' || A.NetClass == '/CM5_HighSpeed/USB3*' || A.NetClass == '/CM5_HighSpeed/PCIE_*X_*' || A.NetClass == '/CM5_HighSpeed/PCIE_*CLK_*') && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
)

(rule Onboard_100R
    (constraint track_width (min 0.227mm) (max 0.227mm))
    (constraint diff_pair_gap (min 0.178mm) (max 0.178mm))
    (condition "(A.NetClass == '/CM5_HighSpeed/DPHY*' || A.NetClass == '/CM5_HighSpeed/HDMI*_D*' || A.NetClass == '/CM5_HighSpeed/HDMI*_CK*' || A.NetClass == '/CM5_GPIO (Ethernet, Gpio, SDCARD)/TRD*') && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
)


# --- Inner Layer Rules - BRUTE FORCE METHOD ---
# Itt már nincs helye a finomkodásnak.

(rule Inner_90R_BruteForce
    (constraint track_width (min 0.178mm) (max 0.178mm))
    (constraint diff_pair_gap (min 0.259mm) (max 0.259mm))
    (condition "(A.NetClass == '/USB2-HUB/*' || A.NetClass == '/CM5_HighSpeed/USB3*' || A.NetClass == '/CM5_HighSpeed/PCIE_*X_*' || A.NetClass == '/CM5_HighSpeed/PCIE_*CLK_*') && (A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu')")
)

(rule Inner_100R_BruteForce
    (constraint track_width (min 0.165mm) (max 0.165mm))
    (constraint diff_pair_gap (min 0.508mm) (max 0.508mm))
    (condition "(A.NetClass == '/CM5_HighSpeed/DPHY*' || A.NetClass == '/CM5_HighSpeed/HDMI*_D*' || A.NetClass == '/CM5_HighSpeed/HDMI*_CK*' || A.NetClass == '/CM5_GPIO (Ethernet, Gpio, SDCARD)/TRD*') && (A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu')")
)



(rule Nuclear_Option
    (constraint track_width (min 1mm))
    (condition "A.NetClass == '/CM5_HighSpeed/PCIE_*X_*'")
)
